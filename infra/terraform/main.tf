# No IAM resources on purpose: the image is pulled from the public Docker Hub repo, so the server needs no AWS role
# (this also keeps the project deployable in restricted accounts such as a Learner Lab).

# ---------------------------------------------------------------- SSH key generated by Terraform for Ansible
resource "tls_private_key" "ssh" { algorithm = "ED25519" }

resource "aws_key_pair" "deployer" {
  key_name   = "${var.project}-deployer"
  public_key = tls_private_key.ssh.public_key_openssh
}

# ---------------------------------------------------------------- server
data "aws_ami" "ubuntu_arm64" {
  most_recent = true
  owners      = ["099720109477"] # Canonical
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-arm64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

resource "aws_instance" "app" {
  ami                    = data.aws_ami.ubuntu_arm64.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnets.default.ids[0]
  vpc_security_group_ids = [aws_security_group.web.id]
  key_name               = aws_key_pair.deployer.key_name
  monitoring             = false

  # Also accept SSH on 443, because many networks block outbound port 22
  user_data_replace_on_change = true
  user_data                   = <<-EOT
    #!/bin/bash
    printf 'Port 22\nPort 443\n' > /etc/ssh/sshd_config.d/10-ports.conf
    systemctl disable --now ssh.socket || true
    systemctl enable ssh
    systemctl restart ssh
  EOT

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }
  root_block_device {
    volume_size = 16
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${var.project}-server" }
  lifecycle { ignore_changes = [ami] }
}

resource "aws_eip" "app" {
  instance = aws_instance.app.id
  domain   = "vpc"
  tags     = { Name = "${var.project}-eip" }
}

# ---------------------------------------------------------------- monitoring
resource "aws_cloudwatch_metric_alarm" "cpu" {
  alarm_name          = "${var.project}-high-cpu"
  alarm_description   = "LiveAttend server CPU above 80% for 5 minutes"
  namespace           = "AWS/EC2"
  metric_name         = "CPUUtilization"
  dimensions          = { InstanceId = aws_instance.app.id }
  statistic           = "Average"
  period              = 300
  evaluation_periods  = 1
  threshold           = 80
  comparison_operator = "GreaterThanThreshold"
}

resource "aws_cloudwatch_metric_alarm" "status" {
  alarm_name          = "${var.project}-status-check"
  alarm_description   = "LiveAttend server failed an EC2 status check"
  namespace           = "AWS/EC2"
  metric_name         = "StatusCheckFailed"
  dimensions          = { InstanceId = aws_instance.app.id }
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 2
  threshold           = 0
  comparison_operator = "GreaterThanThreshold"
}

# ---------------------------------------------------------------- application secrets (stay in Terraform state, never in git)
resource "random_password" "db" {
  length  = 24
  special = false
}
resource "random_password" "admin" {
  length  = 16
  special = false
}
resource "random_password" "secret_key" {
  length  = 48
  special = false
}

# ---------------------------------------------------------------- hand-off to Ansible
resource "local_sensitive_file" "ssh_key" {
  content         = tls_private_key.ssh.private_key_openssh
  filename        = "${path.module}/../ansible/.generated/id_ed25519"
  file_permission = "0600"
}

resource "local_file" "inventory" {
  filename        = "${path.module}/../ansible/.generated/inventory.ini"
  file_permission = "0644"
  content         = <<-EOT
    [liveattend]
    ${aws_eip.app.public_ip} ansible_user=ubuntu ansible_port=443 ansible_ssh_private_key_file=${abspath(path.module)}/../ansible/.generated/id_ed25519
  EOT
}
